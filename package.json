{
  "name": "playwright-framework",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript + Playwright framework for REST API testing and Keycloak-secured React UI E2E testing",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "NODE_OPTIONS=--max-http-header-size=65536 playwright test",
    "test:api": "NODE_OPTIONS=--max-http-header-size=65536 TEST_REPORT_NAME=api-results.json playwright test --project=api",
    "test:e2e": "NODE_OPTIONS=--max-http-header-size=65536 TEST_REPORT_NAME=e2e-results.json playwright test --project=e2e",
    "test:e2e:headed": "NODE_OPTIONS=--max-http-header-size=65536 TEST_REPORT_NAME=e2e-results.json playwright test --project=e2e --headed",
    "report": "playwright show-report",
    "notify:teams": "tsx scripts/notify-teams.ts",
    "keycloak:up": "docker compose up -d",
    "keycloak:down": "docker compose down -v",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@faker-js/faker": "^9.2.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.9.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "zod": "^3.23.8"
  }
}
