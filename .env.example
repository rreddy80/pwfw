# Copy to .env for local runs. In CI (Drone) these are supplied as pipeline secrets instead.

# ---- Application under test (UI) ----
BASE_URL=http://localhost:5173

# ---- REST API under test ----
# Demo defaults to JSONPlaceholder so `npm run test:api` works with zero setup.
API_BASE_URL=https://jsonplaceholder.typicode.com

# ---- Keycloak (Identity & Access Management) ----
# Defaults match the demo realm imported by docker-compose.yml / keycloak/realm-export.json
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=demo
KEYCLOAK_CLIENT_ID=demo-app
# Leave blank for public clients (SPAs). Set only for confidential clients.
KEYCLOAK_CLIENT_SECRET=

# Default test user credentials (seeded by the demo realm export) — what
# authenticatedPage/apiTokens use unless a spec overrides `testUser`.
TEST_USERNAME=testuser
TEST_PASSWORD=Passw0rd!

# A second identity, used only by tests/e2e/multi-user.e2e.spec.ts to prove per-user session
# isolation (seeded by the demo realm export as well). Add more the same plain way if a real
# spec needs another user — there's no registry, just pass {username, password} straight
# into test.use({ testUser: {...} }).
TEST_USERNAME_2=seconduser
TEST_PASSWORD_2=Passw0rd2!

# ---- Teams notifications ----
# A Power Automate "When a Teams webhook request is received" workflow URL.
# Leave blank to skip notification (the notifier logs and exits 0 rather than failing the build).
TEAMS_WEBHOOK_URL=
